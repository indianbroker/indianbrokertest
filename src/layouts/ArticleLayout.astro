---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Sidebar from '../components/Sidebar.astro';
import { breadcrumbSchema, articleSchema } from '../utils/schema.js';
import { DATA_COMPILED } from '../data/brokers.js';

const {
  title,
  metaTitle,
  description,
  path,
  eyebrow = 'Comparison',
  standfirst,
  crumbs = [],
  schemas = [],
  published = '2026-07-09',
  modified = DATA_COMPILED,
} = Astro.props;

const allCrumbs = [{ name: 'Home', path: '/' }, ...crumbs];
const allSchemas = [
  breadcrumbSchema(allCrumbs),
  articleSchema({ title, description, path, datePublished: published, dateModified: modified }),
  ...schemas,
];

const fmt = (d) =>
  new Date(d + 'T00:00:00+05:30').toLocaleDateString('en-IN', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<BaseLayout
  title={metaTitle ?? title}
  description={description}
  path={path}
  ogType="article"
  schemas={allSchemas}
  published={published}
  modified={modified}
>
  <div class="two-col">
    <article>
      <Breadcrumbs crumbs={allCrumbs} />
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {standfirst && <p class="standfirst">{standfirst}</p>}
      <p class="meta-line">
        By the Indian Broker Test editorial desk · Published {fmt(published)} · Data last
        reviewed {fmt(modified)} · Independent
      </p>
      <slot />
    </article>
    <Sidebar />
  </div>
</BaseLayout>
