---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import Faq from '../components/Faq.astro';
import { brokers } from '../data/brokers.js';
import { calculatorPath } from '../data/brokerage-rules.js';
import { collectionPageSchema, faqSchema, itemListSchema } from '../utils/schema.js';

const path = '/brokerage-calculators/';
const sorted = [...brokers].sort((a, b) => a.name.localeCompare(b.name));
const listItems = sorted.map((b) => ({
  slug: b.slug,
  name: `${b.name} brokerage calculator`,
}));

const faqs = [
  {
    q: 'Which Indian brokers have a brokerage calculator on this site?',
    a: `We publish one calculator for each of the ${brokers.length} brokers we track — including Zerodha, Upstox, Groww, Angel One, Dhan, Fyers and others. Each tool uses published official pricing only; statutory charges are excluded.`,
  },
  {
    q: 'Are these brokerage calculators accurate?',
    a: 'They model per-order brokerage from published rate-card text at our last data review. Plan-based brokers may require selecting a documented plan. Unmodelled segments show Not Disclosed rather than a guess. Always verify on the broker\'s official pricing page before trading.',
  },
  {
    q: 'Do the calculators include STT, GST and exchange charges?',
    a: 'No. Each calculator estimates broker brokerage per order only. STT/CTT, exchange transaction charges, GST, stamp duty, SEBI fees and DP charges are additional.',
  },
];

const schemas = [
  collectionPageSchema({
    title: 'Brokerage Calculators for Indian Stock Brokers',
    description:
      'Per-broker brokerage calculators built from published official pricing. Estimate delivery, intraday and F&O charges.',
    path,
  }),
  itemListSchema({
    name: 'Indian stock broker brokerage calculators',
    path,
    items: listItems,
    itemPath: (it) => calculatorPath(it.slug),
  }),
  faqSchema(faqs),
];
---

<ArticleLayout
  title="Brokerage Calculators for Indian Stock Brokers (2026)"
  metaTitle="Brokerage Calculators India (2026) — Every Broker"
  description="Free brokerage calculators for every Indian broker we track. Estimate per-order delivery, intraday and F&O charges from published official pricing."
  path={path}
  eyebrow="Tools"
  standfirst="One calculator per broker — built only from published official pricing. Statutory charges (STT, exchange fees, GST) are not included."
  crumbs={[{ name: 'Brokerage calculators', path }]}
  schemas={schemas}
>
  <p>
    Use these tools to estimate <strong>brokerage per order</strong> for delivery, intraday and F&amp;O
    trades. Compare headline costs on our{' '}
    <a href="/lowest-brokerage-brokers-in-india/">lowest brokerage comparison</a>, any two brokers on
    the <a href="/vs/">head-to-head comparison hub</a>, or read each{' '}
    <a href="/brokers/">broker profile</a> for platforms, APIs and execution data.
  </p>

  <h2>All brokerage calculators</h2>
  <ul class="card-grid">
    {sorted.map((b) => (
      <li class="card">
        <a href={calculatorPath(b.slug)}>{b.name} brokerage calculator</a>
        <p>
          Delivery: {b.brokerage.delivery ?? 'Not Disclosed'}
        </p>
      </li>
    ))}
  </ul>

  <Faq faqs={faqs} />

  <p class="disclaimer">
    Each calculator models brokerage per order from published rate-card text. Plan-based brokers may
    require selecting a documented plan. Unmodelled segments show &ldquo;Not calculable&rdquo; rather
    than an estimate. See our <a href="/methodology/">methodology</a>.
  </p>
</ArticleLayout>
