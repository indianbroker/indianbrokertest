---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import Faq from '../components/Faq.astro';
import { brokers } from '../data/brokers.js';
import { calculatorPath } from '../data/brokerage-rules.js';
import { collectionPageSchema, faqSchema, itemListSchema } from '../utils/schema.js';

const path = '/brokerage-calculators/';
const sorted = [...brokers].sort((a, b) => a.name.localeCompare(b.name));
const listItems = sorted.map((b) => ({
  slug: b.slug,
  name: `${b.name} brokerage calculator`,
}));

const faqs = [
  {
    q: 'Which Indian brokers have a brokerage calculator on this site?',
    a: `We publish one trade cost calculator for each of the ${brokers.length} brokers we track — including Zerodha, Upstox, Groww, Angel One, Dhan, Fyers and others. Each tool estimates brokerage plus statutory charges for delivery, intraday and F&O round trips.`,
  },
  {
    q: 'Are these brokerage calculators accurate?',
    a: 'They model buy-then-sell round trips using published broker rate cards and current statutory rates. Plan-based brokers may require selecting a documented plan. Unmodelled segments show not calculable rather than a guess. Always verify on the broker\'s official pricing page before trading.',
  },
  {
    q: 'Do the calculators include STT, GST and exchange charges?',
    a: 'Yes. Each calculator shows brokerage, STT, exchange transaction charges, GST, SEBI fees, stamp duty and approximate DP charges on delivery sells. Exchange txn rates can vary by stock category.',
  },
];

const schemas = [
  collectionPageSchema({
    title: 'Brokerage Calculators for Indian Stock Brokers',
    description:
      'Per-broker brokerage calculators built from published official pricing. Estimate delivery, intraday and F&O charges.',
    path,
  }),
  itemListSchema({
    name: 'Indian stock broker brokerage calculators',
    path,
    items: listItems,
    itemPath: (it) => calculatorPath(it.slug),
  }),
  faqSchema(faqs),
];
---

<ArticleLayout
  title="Brokerage Calculators for Indian Stock Brokers (2026)"
  metaTitle="Brokerage Calculators India (2026) — Every Broker"
  description="Free trade cost calculators for every Indian broker we track. Estimate delivery, intraday and F&O charges including brokerage, STT, GST and net P&L."
  path={path}
  eyebrow="Tools"
  standfirst="One calculator per broker — full round-trip cost estimates with brokerage, statutory charges, breakeven points and net P&L."
  crumbs={[{ name: 'Brokerage calculators', path }]}
  schemas={schemas}
>
  <p>
    Use these tools to estimate <strong>full trade costs</strong> for delivery, intraday and F&amp;O
    round trips — brokerage, STT, exchange fees, GST, stamp duty, breakeven and net P&amp;L. Browse
    all financial tools on the <a href="/calculators/">calculators hub</a>. Compare headline costs on our{' '}
    <a href="/lowest-brokerage-brokers-in-india/">lowest brokerage comparison</a>, any two brokers on
    the <a href="/vs/">head-to-head comparison hub</a>, or read each{' '}
    <a href="/brokers/">broker profile</a> for platforms, APIs and execution data.
  </p>

  <h2>All brokerage calculators</h2>
  <ul class="card-grid">
    {sorted.map((b) => (
      <li class="card">
        <a href={calculatorPath(b.slug)}>{b.name} brokerage calculator</a>
        <p>
          Delivery: {b.brokerage.delivery ?? 'Not Disclosed'}
        </p>
      </li>
    ))}
  </ul>

  <Faq faqs={faqs} />

  <p class="disclaimer">
    Each calculator models a buy-then-sell round trip from published rate-card text and current
    statutory rates. Plan-based brokers may require selecting a documented plan. Unmodelled segments
    show &ldquo;Not calculable&rdquo; rather than an estimate. See our{' '}
    <a href="/methodology/">methodology</a>.
  </p>
</ArticleLayout>
