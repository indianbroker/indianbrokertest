---
const { links } = Astro.props;
---

<aside class="calc-sidebar" aria-label="Popular calculators">
  <div class="calc-sidebar-inner">
    <div class="calc-sidebar-cta">
      <div class="calc-sidebar-cta-body">
        <h2>Compare Indian brokers</h2>
        <p>
          Independent comparison of brokerage, platforms, APIs and execution speed — from published
          official data only.
        </p>
        <a class="calc-sidebar-cta-btn" href="/best-stock-brokers-in-india/">View comparison</a>
      </div>
    </div>

    <div class="calc-sidebar-popular">
      <h2>Popular Calculators</h2>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</aside>
